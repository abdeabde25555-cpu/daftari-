<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>دعوة عيد ميلاد ايلين</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@700&family=Reem+Kufi:wght@500;700&family=Tajawal:wght@400;500&display=swap">
<style>
:root{--bg1:#f6d8dd;--bg2:#fcefe6;--paper:#fffaf5;--ink:#4a2545;--soft:#85607f;--gold:#b8923a;--line:#e6c89a;--blush:#fde4e6;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg1:#2b1631;--bg2:#3d2140}}
:root[data-theme="dark"]{--bg1:#2b1631;--bg2:#3d2140}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;min-height:100svh;background:radial-gradient(circle at 15% 10%,var(--bg2),transparent 55%),radial-gradient(circle at 88% 92%,var(--bg2),transparent 50%),var(--bg1);color:var(--ink);font-family:'Tajawal',system-ui,sans-serif;line-height:1.7;display:flex;align-items:center;justify-content:center;padding:28px 14px;overflow-x:hidden}
/* envelope */
#env{position:fixed;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 40%,var(--bg2),var(--bg1));z-index:5;cursor:pointer;transition:opacity .7s .5s,visibility 0s 1.2s;gap:24px}
#env.open{opacity:0;visibility:hidden}
.ev{position:relative;width:min(84vw,340px);aspect-ratio:1.45;background:#ffffff;border-radius:6px;box-shadow:0 16px 36px rgba(74,37,69,.22);perspective:900px}
.ev:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,transparent 49.5%,#f0f0f0 50%) left/50% 100% no-repeat,linear-gradient(225deg,transparent 49.5%,#f0f0f0 50%) right/50% 100% no-repeat;border-radius:6px}
.fl{position:absolute;top:0;left:0;right:0;height:56%;background:#f7f7f7;clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:top;transition:transform .6s;z-index:2}
#env.open .fl{transform:rotateX(180deg)}
.seal{position:absolute;left:50%;top:56%;width:62px;height:62px;margin:-31px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#e8c876,#a8782a);color:#fff;display:grid;place-items:center;font-family:'Aref Ruqaa',serif;font-size:21px;z-index:3;box-shadow:0 3px 8px rgba(0,0,0,.3);transition:opacity .3s}
#env.open .seal{opacity:0}
.tap{font-size:18px;font-weight:700;color:#ffffff;text-shadow:0 2px 4px rgba(0,0,0,.3);letter-spacing:0.5px;}
/* music toggle button */
#mus-btn{position:fixed;top:16px;left:16px;z-index:10;background:#ffffff;border:1.5px solid var(--gold);color:var(--ink);padding:8px 14px;border-radius:999px;font-family:'Reem Kufi',serif;font-size:14px;cursor:pointer;box-shadow:0 4px 12px rgba(0,0,0,.15);display:flex;align-items:center;gap:6px;transition:all .3s}
#mus-btn:active{transform:scale(0.95)}
/* card */
.card{width:min(100%,420px);background:radial-gradient(circle at 12% 30%,#fde4e6,transparent 40%),radial-gradient(circle at 92% 96%,#e8eedc,transparent 42%),var(--paper);border-radius:999px 999px 8px 8px;padding:10px;box-shadow:0 24px 64px rgba(74,37,69,.34);color:#4a2545;opacity:0;transform:translateY(26px);transition:opacity .8s .9s,transform .8s .9s}
.card.show{opacity:1;transform:none}
.in{border:1.5px solid var(--gold);outline:1px solid var(--line);outline-offset:-7px;border-radius:999px 999px 4px 4px;padding:0 24px 40px;text-align:center;overflow:hidden}
.arch{display:block;width:calc(100% + 48px);margin:0 -24px -6px}
.fy{animation:fy 5s ease-in-out infinite}.fy2{animation-delay:-2s}.fy3{animation-delay:-3.4s}
@keyframes fy{50%{translate:0 -6px}}
.k{font-size:17px;color:var(--soft);margin:0}
h1{font-family:'Aref Ruqaa',serif;font-weight:700;font-size:78px;line-height:1.35;margin:0;color:#b8923a;background:linear-gradient(135deg,#9a6c22,#ecd08a 38%,#b8923a 58%,#f2dc9c 82%);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.age{font-family:'Reem Kufi',serif;font-size:25px;margin:-4px 0 0}
.born{display:inline-flex;align-items:center;gap:7px;margin:12px 0 0;padding:5px 16px;border-radius:999px;background:var(--blush);font-size:15px;color:var(--soft)}
.born svg{width:16px;height:16px}
.rule{display:flex;align-items:center;gap:10px;margin:22px 0}
.rule:before,.rule:after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,var(--gold))}
.rule:after{transform:scaleX(-1)}
.rule svg{width:18px;height:18px}
.date{display:flex;align-items:center;justify-content:center;gap:14px;font-size:15px;color:var(--soft)}
.date b{display:block;font-family:'Reem Kufi',serif;font-size:21px;color:#4a2545;font-weight:500;line-height:1.5}
.big{font-family:'Reem Kufi',serif;font-size:64px;line-height:1;color:var(--gold);border-inline:1px solid var(--line);padding:0 18px}
.place b{display:block;font-family:'Reem Kufi',serif;font-size:25px;font-weight:500;line-height:1.4}
.place span{color:var(--soft);font-size:15px}
.cd{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.cd div{background:var(--blush);border:1px solid var(--line);border-radius:14px;padding:8px 2px}
.cd b{display:block;font-family:'Reem Kufi',serif;font-size:27px;line-height:1.2}
.cd span{font-size:13px;color:var(--soft)}
.btns{display:flex;gap:10px;margin-top:24px}
.btns a{flex:1;padding:12px 6px;border-radius:999px;text-decoration:none;font-family:'Reem Kufi',serif;font-size:17px;border:1.5px solid var(--gold);color:#4a2545}
.btns a.p{background:linear-gradient(135deg,#a8782a,#d8b658);color:#fff;border-color:transparent}
.btns a:focus-visible{outline:3px solid #4a2545;outline-offset:2px}
.note{font-family:'Aref Ruqaa',serif;font-size:22px;color:var(--gold);margin:20px 0 0}
@media (prefers-reduced-motion:reduce){*{transition-duration:.01s!important;transition-delay:0s!important;animation:none!important}}
</style>
</head>
<body>

<!-- عنصر الصوت (استبدل رابط الملف الصوتي برابط الأغنية المباشر إذا توفر لديك عبر رابط عام) -->
<audio id="bg-music" loop>
  <source src="" type="audio/mp4">
</audio>

<!-- زر التحكم بالموسيقى -->
<button id="mus-btn" aria-label="تشغيل وإيقاف الموسيقى">🎵 <span id="mus-txt">تشغيل الأغنية</span></button>

<svg width="0" height="0" style="position:absolute" aria-hidden="true"><defs>
<linearGradient id="gw" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e88fa0"/><stop offset="1" stop-color="#f7c9a6"/></linearGradient>
<linearGradient id="gp" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#f8c3cd"/><stop offset="1" stop-color="#e88fa0"/></linearGradient>
<linearGradient id="gl" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#9fb38c"/><stop offset="1" stop-color="#c6d5b4"/></linearGradient>
<symbol id="bfy" viewBox="0 0 100 80"><path d="M50 40C44 14 20 2 8 10c-8 9 2 28 22 26 8-1 14 0 20 4z" fill="url(#gw)" stroke="#b8923a" stroke-width="1.4"/><path d="M50 40C56 14 80 2 92 10c8 9-2 28-22 26-8-1-14 0-20 4z" fill="url(#gw)" stroke="#b8923a" stroke-width="1.4"/><path d="M50 42C36 44 20 52 24 66c4 12 20 6 27-12z" fill="url(#gp)" stroke="#b8923a" stroke-width="1.4"/><path d="M50 42c14 2 30 10 26 24-4 12-20 6-27-12z" fill="url(#gp)" stroke="#b8923a" stroke-width="1.4"/><circle cx="26" cy="20" r="5" fill="#fff" opacity=".55"/><circle cx="74" cy="20" r="5" fill="#fff" opacity=".55"/><rect x="48" y="26" width="4" height="34" rx="2" fill="#4a2545"/><path d="M50 27c-4-8-8-11-12-12M50 27c4-8 8-11 12-12" stroke="#4a2545" stroke-width="1.4" fill="none"/></symbol>
<symbol id="lf" viewBox="0 0 30 20"><path d="M0 10C8 0 22 0 30 10 22 20 8 20 0 10z" fill="url(#gl)"/><path d="M2 10h26" stroke="#7f9570" stroke-width=".8"/></symbol>
<symbol id="fw" viewBox="-30 -30 60 60"><g fill="url(#gp)" stroke="#e07c91" stroke-width=".6"><ellipse cy="-14" rx="9" ry="14"/><ellipse cy="-14" rx="9" ry="14" transform="rotate(72)"/><ellipse cy="-14" rx="9" ry="14" transform="rotate(144)"/><ellipse cy="-14" rx="9" ry="14" transform="rotate(216)"/><ellipse cy="-14" rx="9" ry="14" transform="rotate(288)"/></g><circle r="6" fill="#d8b658"/><circle r="2.5" fill="#fff3c9"/></symbol>
<symbol id="st" viewBox="-10 -10 20 20"><path d="M0-9C1 -3 3-1 9 0 3 1 1 3 0 9-1 3-3 1-9 0-3-1-1-3 0-9z" fill="#d8b658"/></symbol>
</defs></svg>

<div id="env" role="button" tabindex="0" aria-label="افتح الدعوة">
<div class="ev"><div class="fl"></div><div class="seal">ايلين</div></div>
<div class="tap">المس الظرف لفتح الدعوة</div>
</div>

<article class="card" id="card"><div class="in">
<svg class="arch" viewBox="0 0 400 290" aria-hidden="true">
<path d="M30 220A170 170 0 0 1 370 220" stroke="#8fa57d" stroke-width
